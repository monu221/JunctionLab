# Streamlit Community Cloud: paste this into the app's Secrets (Advanced settings or app
# settings). Locally, copy it to .streamlit/secrets.toml, or use .env for the key instead.
# Never commit secrets.toml.

# Free Groq key from https://console.groq.com/keys. Needed to read descriptions and run the
# agent; the bundled examples work without it.
GROQ_API_KEY = ""

# SUMO processes at once per run. Community Cloud has 2 cores; config.yaml runs all 5 seeds
# at once locally.
JUNCTIONLAB_MAX_PARALLEL_RUNS = 2
